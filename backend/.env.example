# 后端服务端口（与前端 vite dev 代理 127.0.0.1:8029 对齐）
PORT=8029

# SQLite 数据库文件路径（相对 backend/ 目录）
DATABASE_PATH=data/hr.db

# ---------------- 真实大模型（OpenAI 兼容端点）配置 ----------------
# API Key（请替换为你的真实 key；backend/.env 已被 .gitignore 忽略，切勿提交）
LLM_API_KEY=your_llm_api_key_here
# OpenAI 兼容端点 base_url（SDK 会在其后拼接 /chat/completions）
LLM_BASE_URL=https://xuseny.online/v1
# 模型标识（以 GET /api/llm/models 返回的可用模型为准，不符请修改本项）
LLM_MODEL=gpt-5.5
# 生成温度（0 更确定，1 更发散）
LLM_TEMPERATURE=0.7
# 单次请求超时（秒），防止挂死
LLM_TIMEOUT=60
# JSON 解析/校验失败后的最大重试次数（把错误回灌模型自我修正）
LLM_MAX_RETRIES=2

# 旧占位（保留以兼容）
# GEMINI_API_KEY=

# 原始简历文件存储目录（相对 backend/ 或绝对路径；默认仓库根 uploads/）
UPLOAD_DIR=
# 简历上传体积上限（字节），默认 10MB
MAX_UPLOAD_SIZE=10485760
